default: &default
  adapter: postgresql
  encoding: unicode
  host: localhost
  port: 5432
  username: postgres
  password: YOUR_POSTGRES_PASSWORD
  pool: <%= ENV.fetch("RAILS_MAX_THREADS", 5) %>

development:
  <<: *default
  database: course_tutor_api_development

test:
  <<: *default
  database: course_tutor_api_test

production:
  <<: *default
  database: course_tutor_api_production
